PORT=5000
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/weavestudio
JWT_SECRET=your_jwt_secret_change_this_in_production
ADMIN_EMAIL=admin@weavestudio.com
ADMIN_PASSWORD=admin123

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ==========================================
# Notification Platform
# ==========================================


# Email (SMTP / Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM="WeaveStudio Atelier <noreply@weavestudio.in>"
NOTIFY_EMAIL=owner@weavestudio.com

# SMS (Twilio / Gateway Adapter)
SMS_PROVIDER=twilio
SMS_API_KEY=your_twilio_account_sid
SMS_API_SECRET=your_twilio_auth_token
SMS_SENDER_ID=+18005550199
SMS_BASE_URL=https://api.twilio.com/2010-04-01

# Rate Limiting
NOTIFICATION_RATE_LIMIT_WINDOW_MS=60000
NOTIFICATION_RATE_LIMIT_MAX=10
